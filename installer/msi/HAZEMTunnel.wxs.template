<!--
  HAZEM Tunnel — Windows MSI installer (WiX Toolset 5) — TEMPLATE

  This file is a TEMPLATE: the @@HARVESTED_*@@ placeholders are filled by
  installer/msi/gen_wxs.py from the publish/win-x64 output folder, producing the
  real .wxs that WiX compiles. Never build this template directly.

  Why a generator instead of WiX v5 <Files> harvesting?
    - The classic Component/File authoring works identically on WiX 5 and is fully
      deterministic and reviewable in the generated output.

  Build (Windows / CI only — WiX 5 does not run on Linux):
    1. dotnet tool install -g wix        (version 5.0.2)
    2. wix extension add -g WixToolset.Util.wixext/5.0.2
    3. python installer/msi/gen_wxs.py
           publish.dir=publish/win-x64   (via arguments: see gen_wxs.py)
           template=installer/msi/HAZEMTunnel.wxs.template
           out=obj/msi/HAZEMTunnel.wxs
    4. wix build -arch x64 -ext WixToolset.Util.wixext
         -d "PublishDir=publish/win-x64/"
         -d "AppIcon=src/HAZEM.Tunnel.App/Assets/app.ico"
         obj/msi/HAZEMTunnel.wxs
         -o "dist/HAZEM-Tunnel-(version)-setup.msi"

  What this installer does (like any normal Windows program):
    - Installs the FULL self-contained program folder (HAZEM.Tunnel.exe + every
      runtime file) into %ProgramFiles%\HAZEM Tunnel (64-bit). No single-file
      TEMP extraction at runtime: the app runs straight from Program Files,
      which is faster and friendlier to antivirus software.
    - MSZIP cabinet compression: the most conservative, universally-supported
      MSI codec — decoded by Windows Installer's own built-in code paths.
    - Start Menu shortcut (HAZEM Tunnel → HAZEM.Tunnel.exe)
    - Desktop shortcut
    - Registers in "Apps & features" with an entry icon + project links
    - Closes a running HAZEM.Tunnel.exe during install/upgrade (no "file in
      use" or reboot prompts; a leftover portable copy will not block setup).
    - Major-upgrade aware: installing 1.2.1 over 1.2.0 replaces it; installing
      an older build over a newer one is refused.
    - Clean uninstall: removes the program files and shortcuts. User data
      (%LocalAppData%\HAZEMTunnel) is deliberately preserved.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

  <Package Name="HAZEM Tunnel"
           Manufacturer="HAZEM"
           Version="1.2.1"
           UpgradeCode="189C476F-07E3-4FE3-BBC5-99526E42A0D9"
           Scope="perMachine"
           Compressed="yes"
           Language="1033"
           Codepage="1252">

    <SummaryInformation Description="HAZEM Tunnel — Windows TLS/SSH/WebSocket tunneling desktop client with a local SOCKS5 proxy" />

    <MajorUpgrade DowngradeErrorMessage="A newer version of [ProductName] ([CurrentVersion]) is already installed. Uninstall it first." />

    <!-- MSZIP: conservative + universally supported cabinet compression -->
    <MediaTemplate EmbedCab="yes" CompressionLevel="mszip" />

    <!-- Add/Remove Programs entry -->
    <Property Id="ARPPRODUCTICON" Value="HazemTunnelIcon" />
    <Property Id="ARPHELPLINK" Value="https://github.com/hazmmhmdalshadhly12-ui/Tls" />
    <Property Id="ARPURLINFOABOUT" Value="https://github.com/hazmmhmdalshadhly12-ui/Tls" />
    <Icon Id="HazemTunnelIcon" SourceFile="$(AppIcon)" />

    <!-- If the app is running (installed or leftover portable copy), close it
         during install/upgrade instead of failing with "file in use". -->
    <util:CloseApplication Id="CloseHazemTunnel"
                           Target="HAZEM.Tunnel.exe"
                           CloseMessage="yes"
                           TerminateProcess="1"
                           RebootPrompt="no" />

    <!-- 64-bit Program Files — one component per file, generated by gen_wxs.py -->
    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="HAZEM Tunnel">
@@HARVESTED_COMPONENTS@@
      </Directory>
    </StandardDirectory>

    <!-- Start Menu folder + shortcut -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="AppProgramMenuFolder" Name="HAZEM Tunnel">
        <Component Id="StartMenuShortcuts" Guid="EC754B65-815A-43B2-9F98-D4528927DAF0">
          <Shortcut Id="StartMenuApp"
                    Name="HAZEM Tunnel"
                    Description="Route your apps through TLS/SSH/WebSocket tunnels via a local SOCKS5 proxy"
                    Target="[INSTALLFOLDER]HAZEM.Tunnel.exe"
                    WorkingDirectory="INSTALLFOLDER"
                    Icon="HazemTunnelIcon" />
          <RemoveFolder Id="RemoveAppProgramMenuFolder" Directory="AppProgramMenuFolder" On="uninstall" />
          <RegistryValue Root="HKCU" Key="Software\HAZEM\Tunnel"
                         Name="StartMenuShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <!-- Desktop shortcut -->
    <StandardDirectory Id="DesktopFolder">
      <Component Id="DesktopShortcut" Guid="F477FBD5-D382-4781-B0CA-9079311D576A">
        <Shortcut Id="DesktopApp"
                  Name="HAZEM Tunnel"
                  Description="HAZEM Tunnel"
                  Target="[INSTALLFOLDER]HAZEM.Tunnel.exe"
                  WorkingDirectory="INSTALLFOLDER"
                  Icon="HazemTunnelIcon" />
        <RegistryValue Root="HKCU" Key="Software\HAZEM\Tunnel"
                       Name="DesktopShortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>

    <Feature Id="Main"
             Title="HAZEM Tunnel"
             Description="Installs HAZEM.Tunnel.exe, its runtime files and shortcuts."
             Level="1"
             AllowAbsent="no">
      <ComponentRef Id="StartMenuShortcuts" />
      <ComponentRef Id="DesktopShortcut" />
@@HARVESTED_COMPONENTREFS@@
    </Feature>

  </Package>
</Wix>
