<Window x:Class="HAZEM.Tunnel.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:HAZEM.Tunnel.App.Views"
        Title="HAZEM Tunnel" Height="720" Width="1120"
        MinHeight="560" MinWidth="880"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Bg}"
        FontFamily="Segoe UI">
    <Window.Resources>
        <DataTemplate x:Key="NavTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock Text="{Binding Glyph}" FontFamily="Segoe MDL2 Assets" FontSize="15"
                           Margin="0,0,10,0" VerticalAlignment="Center" />
                <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
            </StackPanel>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════ Sidebar ═══════ -->
        <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="0,0,1,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Margin="16,18,16,14">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{StaticResource Accent}">
                            <TextBlock Text="H" FontWeight="Bold" FontSize="19" Foreground="#06202B"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="HAZEM Tunnel" FontWeight="SemiBold" FontSize="15" Foreground="{StaticResource Fg}" />
                            <TextBlock Text="{Binding VersionLabel}" FontSize="11" Foreground="{StaticResource FgDim}" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage, Mode=TwoWay}"
                         ItemTemplate="{StaticResource NavTemplate}" Margin="0,4" />

                <!-- Honest scope: planned system-wide VPN is clearly marked, not clickable -->
                <StackPanel DockPanel.Dock="Bottom" Margin="16,0,16,14">
                    <Border Background="#172033" BorderBrush="{StaticResource Border}" BorderThickness="1"
                            CornerRadius="8" Padding="10,8" Opacity="0.75">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE9F5;" FontFamily="Segoe MDL2 Assets" FontSize="14"
                                       Foreground="{StaticResource FgDim}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock Text="System-wide VPN — Planned" Foreground="{StaticResource FgDim}" FontSize="11.5"
                                       VerticalAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- ═══════ Content ═══════ -->
        <ContentControl Grid.Column="1" Content="{Binding CurrentView}" Margin="0" />
    </Grid>
</Window>
