<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <RootNamespace>HAZEM.Tunnel.App</RootNamespace>
    <AssemblyName>HAZEM.Tunnel</AssemblyName>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <InvariantGlobalization>false</InvariantGlobalization>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <Description>HAZEM Tunnel - Windows desktop TLS/SSH/WebSocket tunneling client with local SOCKS5 proxy.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\HAZEM.Tunnel.Core\HAZEM.Tunnel.Core.csproj" />
    <ProjectReference Include="..\HAZEM.Tunnel.Infrastructure\HAZEM.Tunnel.Infrastructure.csproj" />
    <ProjectReference Include="..\HAZEM.Tunnel.Networking\HAZEM.Tunnel.Networking.csproj" />
  </ItemGroup>

</Project>
