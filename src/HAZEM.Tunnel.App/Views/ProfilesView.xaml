<UserControl x:Class="HAZEM.Tunnel.App.Views.ProfilesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Profiles" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Dim}"
                       Text="Profiles store connection settings. Secrets are kept in the OS credential store — exported files contain references only." />

            <StackPanel Orientation="Horizontal" Margin="0,18,0,10">
                <Button Content="＋ New" Style="{StaticResource PrimaryButton}" Command="{Binding NewCommand}" Margin="0,0,8,0" />
                <Button Content="Edit" Command="{Binding EditCommand}" Margin="0,0,8,0" />
                <Button Content="Duplicate" Command="{Binding DuplicateCommand}" Margin="0,0,8,0" />
                <Button Content="Delete" Command="{Binding DeleteCommand}" Margin="0,0,8,0" />
                <Button Content="Import…" Command="{Binding ImportCommand}" Margin="0,0,8,0" />
                <Button Content="Export…" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
                <Button Content="Reload" Command="{Binding ReloadCommand}" />
            </StackPanel>

            <DataGrid x:Name="ProfilesGrid" ItemsSource="{Binding Rows}"
                      SelectedItem="{Binding Selected}" MinHeight="220">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="180" />
                    <DataGridTextColumn Header="Transport" Binding="{Binding Kind}" Width="100" />
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" />
                    <DataGridTemplateColumn Header="Validation" Width="110">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding ValidationText}" FontSize="12">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{StaticResource Good}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsValid}" Value="False">
                                                    <Setter Property="Foreground" Value="{StaticResource Bad}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <TextBlock Text="{Binding ValidationSummary}" Style="{StaticResource Dim}" Margin="0,10,0,0" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
