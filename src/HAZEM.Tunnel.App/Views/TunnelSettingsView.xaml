<UserControl x:Class="HAZEM.Tunnel.App.Views.TunnelSettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="Tunnel Settings" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Dim}"
                       Text="How to point your applications at the tunnel. Per-profile defaults live inside each profile." />

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Local SOCKS5 proxy" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}"
                               Text="While a tunnel is connected, HAZEM Tunnel exposes a SOCKS5 proxy at 127.0.0.1 on the port configured in the active profile (default 1080)." />
                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                        <TextBox Text="{Binding ProxyAddressExample}" IsReadOnly="True" MinWidth="160" />
                        <Button Content="Copy" Command="{Binding CopyProxyAddressCommand}" Margin="10,0,0,0" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Which apps are tunneled?" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                               Text="Only applications whose proxy settings point at this SOCKS5 address. Examples: browsers (via a proxy add-on), download managers, terminals (e.g. curl --proxy socks5h://127.0.0.1:1080)." />
                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0"
                               Text="Everything else on your system connects directly, unchanged. A system-wide VPN (routing all traffic) is planned for a future version and is NOT part of this release." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Transport concepts (kept separate on purpose)" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,4,0,0"
                               Text="• SNI (Server Name Indication) — the hostname announced inside the TLS ClientHello. Used by TLS-based transports only." />
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="• SSH host/port — the SSH server you authenticate to. Used by SSH-based transports only." />
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="• Remote forward target — the destination the SSH server connects to on your behalf (what the exit sees)." />
                    <TextBlock Style="{StaticResource Body}" Margin="0,6,0,0"
                               Text="• WebSocket endpoint — a full URL (ws:// or wss://host:port/path). Only used by the WebSocket transport." />
                    <TextBlock Style="{StaticResource Body}" Margin="0,10,0,0" Foreground="{StaticResource Warn}"
                               Text="These are different fields for different transports. Filling one does not fill the others, and reusing a value across them will not make a connection work." />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
