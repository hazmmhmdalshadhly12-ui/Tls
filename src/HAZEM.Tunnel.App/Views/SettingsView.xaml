<UserControl x:Class="HAZEM.Tunnel.App.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="760" HorizontalAlignment="Left">
            <TextBlock Text="Settings" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Dim}" Text="Application-wide preferences. Saved immediately when you press Save." />

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="Logging" Style="{StaticResource H2}" />
                    <Grid Margin="0,4,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Retention (days)" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding LogRetentionDays}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="Older files are deleted at startup." Style="{StaticResource Dim}" VerticalAlignment="Center" />
                    </Grid>
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Max file size (MB)" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding LogMaxSizeMb}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="Size rotates within the same day." Style="{StaticResource Dim}" VerticalAlignment="Center" />
                    </Grid>
                    <CheckBox Content="Redact secret-looking values in logs (recommended, cannot fully un-redact later)"
                              IsChecked="{Binding RedactSecrets}" IsEnabled="False" Margin="0,0,0,4" />
                    <TextBlock Style="{StaticResource Dim}" Margin="0,4,0,0"
                               Text="Redaction is always applied in v1.1.0 — the checkbox documents the guarantee; disabling it is not supported." />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Health checks" Style="{StaticResource H2}" />
                    <TextBlock Style="{StaticResource Body}" Margin="0,0,0,10"
                               Text="While connected, the engine probes through the tunnel. After repeated consecutive failures it restarts the tunnel automatically." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="240" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Interval (seconds)" Style="{StaticResource Body}" VerticalAlignment="Center" />
                        <TextBox Grid.Column="1" Text="{Binding HealthIntervalSeconds}" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="2" Text="10–3600 s." Style="{StaticResource Dim}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>

            <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}"
                    Margin="0,16,0,0" HorizontalAlignment="Left" MinWidth="140" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
