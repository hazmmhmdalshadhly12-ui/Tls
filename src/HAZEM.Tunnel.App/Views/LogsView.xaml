<UserControl x:Class="HAZEM.Tunnel.App.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="28,24" MaxWidth="1100" HorizontalAlignment="Left">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Logs" Style="{StaticResource H1}" />
        <TextBlock Grid.Row="0" Style="{StaticResource Dim}" Margin="0,0,0,10"
                   Text="Live in-memory view. The rotating file log lives in %LocalAppData%\HAZEMTunnel\logs — secret values are redacted before anything is written." />

        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,10">
            <CheckBox Content="Info" IsChecked="{Binding ShowInfo}" Margin="0,0,14,0" VerticalAlignment="Center" />
            <CheckBox Content="Warnings" IsChecked="{Binding ShowWarn}" Margin="0,0,14,0" VerticalAlignment="Center" />
            <CheckBox Content="Errors" IsChecked="{Binding ShowError}" Margin="0,0,14,0" VerticalAlignment="Center" />
            <TextBox Text="{Binding FilterText, UpdateSourceTrigger=PropertyChanged}" MinWidth="220"
                     VerticalAlignment="Center" Margin="0,0,14,0" />
            <Button Content="Reload" Command="{Binding ReloadCommand}" Margin="0,0,8,0" />
            <Button Content="Clear view" Command="{Binding ClearCommand}" Margin="0,0,8,0" />
            <Button Content="Export…" Command="{Binding ExportCommand}" Margin="0,0,8,0" />
            <Button Content="Open log folder" Command="{Binding OpenLogFolderCommand}" />
        </StackPanel>

        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Border}"
                BorderThickness="1" CornerRadius="8" Padding="4">
            <ListBox ItemsSource="{Binding Events}" Background="Transparent"
                     BorderThickness="0">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock FontFamily="Consolas" FontSize="12" TextWrapping="Wrap">
                            <Run Text="{Binding Timestamp, Mode=OneWay, StringFormat=yyyy-MM-dd HH:mm:ss}" Foreground="{StaticResource FgDim}" />
                            <Run Text="{Binding Level, Mode=OneWay}" Foreground="{StaticResource Accent}" />
                            <Run Text="{Binding Message, Mode=OneWay}" />
                        </TextBlock>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <TextBlock Grid.Row="3" Style="{StaticResource Dim}" Margin="0,8,0,0"
                   Text="Tip: use “Open log folder” to reach the on-disk rotating logs for support requests." />
    </Grid>
</UserControl>
