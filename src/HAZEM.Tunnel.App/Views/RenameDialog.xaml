<Window x:Class="HAZEM.Tunnel.App.Views.RenameDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rename" Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg}" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock Text="New name" Style="{StaticResource Dim}" />
        <TextBox x:Name="NameBox" Margin="0,6,0,14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Cancel" IsCancel="True" Margin="0,0,8,0" MinWidth="90" />
            <Button Content="OK" IsDefault="True" Click="OnOk" Style="{StaticResource PrimaryButton}" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>
