<UserControl x:Class="HAZEM.Tunnel.App.Views.StatisticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:HAZEM.Tunnel.App.Views.Controls">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="980" HorizontalAlignment="Left">
            <TextBlock Text="Statistics" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Dim}"
                       Text="All numbers are measured from real relayed bytes. When no pipes are active, values are zero — by design." />

            <UniformGrid Columns="4" Margin="0,18,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total sent" Style="{StaticResource Dim}" />
                        <TextBlock Text="{Binding TotalSent}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total received" Style="{StaticResource Dim}" />
                        <TextBlock Text="{Binding TotalRecv}" FontSize="21" FontWeight="SemiBold" Foreground="{StaticResource Accent}" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Send rate" Style="{StaticResource Dim}" />
                        <TextBlock Text="{Binding SendRate}" FontSize="21" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Receive rate" Style="{StaticResource Dim}" />
                        <TextBlock Text="{Binding RecvRate}" FontSize="21" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Throughput (last 10 minutes, 1s samples)" Style="{StaticResource H2}" />
                    <controls:SimpleLineChart SeriesSent="{Binding SeriesSent}" SeriesRecv="{Binding SeriesRecv}"
                                              Height="220" />
                </StackPanel>
            </Border>

            <UniformGrid Columns="4" Margin="0,14,0,0">
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Active pipes" Style="{StaticResource Dim}" />
                        <TextBlock Text="{Binding ActiveConns}" FontSize="21" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Total pipes" Style="{StaticResource Dim}" />
                        <TextBlock Text="{Binding TotalConns}" FontSize="21" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Reconnects" Style="{StaticResource Dim}" />
                        <TextBlock Text="{Binding Reconnects}" FontSize="21" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Uptime" Style="{StaticResource Dim}" />
                        <TextBlock Text="{Binding Uptime}" FontSize="21" FontWeight="SemiBold" />
                    </StackPanel>
                </Border>
            </UniformGrid>
        </StackPanel>
    </ScrollViewer>
</UserControl>
