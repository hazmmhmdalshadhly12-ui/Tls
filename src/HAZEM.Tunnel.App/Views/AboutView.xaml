<UserControl x:Class="HAZEM.Tunnel.App.Views.AboutView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28,24" MaxWidth="820" HorizontalAlignment="Left">
            <TextBlock Text="About" Style="{StaticResource H1}" />
            <TextBlock Style="{StaticResource Dim}" Text="{Binding AppName}" FontSize="15" Margin="0,0,0,2" />
            <TextBlock Style="{StaticResource Dim}" Text="{Binding Version}" />

            <Border Style="{StaticResource Card}" Margin="0,18,0,0">
                <StackPanel>
                    <TextBlock Text="What this app does" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding Purpose}" Style="{StaticResource Body}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Honest scope (read this first)" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding ScopeHonest}" Style="{StaticResource Body}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="Security model" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding SecurityNotes}" Style="{StaticResource Body}" />
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Margin="0,14,0,0">
                <StackPanel>
                    <TextBlock Text="License" Style="{StaticResource H2}" />
                    <TextBlock Text="{Binding License}" Style="{StaticResource Body}" />
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
